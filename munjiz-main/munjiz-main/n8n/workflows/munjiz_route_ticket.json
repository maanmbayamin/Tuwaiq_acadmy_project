    {
      "id": "609c9dfa-4210-572f-90d5-b56ad92b51a2",
      "name": "One item per desk part",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        140
      ],
      "parameters": {
        "jsCode": "// One item per desk part, carrying the ticket fields each desk needs.\nconst body = $input.first().json.body;\nreturn body.sub_requests.map((part) => ({\n  json: { ...part, ticket_id: body.ticket_id, pavilion: body.pavilion, language: body.language },\n}));"
      }
    },
