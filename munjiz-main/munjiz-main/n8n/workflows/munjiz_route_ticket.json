    {
      "id": "e24b7e60-d0b1-56eb-b0dd-3e90721a5edd",
      "name": "Compose desk alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        140
      ],
      "parameters": {
        "jsCode": "// Alert text for the desk team, with a one-click link back to Munjiz.\nconst part = $('One item per desk part').item.json;\nreturn {\n  json: {\n    desk: part.desk_title,\n    desk_ref: $json.desk_ref,\n    text: `New ${part.desk_title} request ${part.id} from ${part.pavilion} (ref ${$json.desk_ref}): ${part.summary}`,\n    decision_url: part.decision_url,\n  },\n};",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "9684795f-4858-56a9-87e5-edd065c16be6",
      "name": "Notify desk team",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1480,
        140
      ],
      "parameters": {},
      "notes": "Connect Slack, Teams or email here",
      "notesInFlow": true
    },
    {
      "id": "6b0b9fd7-ebc3-5a3b-b44f-898af2a5352e",
      "name": "Compose participant update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        440
      ],
      "parameters": {
        "jsCode": "// Update for the participant, in the language they wrote in.\nconst b = $input.first().json.body;\nconst desks = { logistics: 'Logistics & Site Access', security: 'Accreditation & Security', facilities: 'Facilities & Utilities' };\nconst desksAr = { logistics: 'اللوجستيات ودخول الموقع', security: 'الاعتماد والأمن', facilities: 'المرافق والخدمات' };\nconst ar = b.language === 'ar';\nlet text;\nif (b.event === 'ticket_completed') {\n  text = ar ? `طلبك ${b.ticket_id} منجز. وافقت جميع الجهات.`\n            : `Your request ${b.ticket_id} is done. All desks approved in ${b.minutes_to_complete} min.`;\n} else if (b.status === 'approved') {\n  text = ar ? `${desksAr[b.desk]} وافقت على جزء من طلبك ${b.ticket_id}.` : `${desks[b.desk]} approved its part of ${b.ticket_id}.`;\n} else if (b.status === 'changes_requested') {\n  text = ar ? `${desksAr[b.desk]} تطلب تعديل جزئها من ${b.ticket_id}: ${b.reason}. افتح منجز وأرسل التصحيح لهذا الجزء فقط.`\n            : `${desks[b.desk]} asks for a change to its part of ${b.ticket_id}: ${b.reason}. Open Munjiz and fix that part only.`;\n} else {\n  text = ar ? `${desksAr[b.desk]} تحتاج تعديلًا على ${b.ticket_id}: ${b.reason}` : `${desks[b.desk]} needs a change on ${b.ticket_id}: ${b.reason}`;\n}\nreturn [{ json: { to: b.pavilion, ticket_id: b.ticket_id, channel: 'Expo app push', text } }];"
      }
    },
    {
      "id": "b0de4d17-132a-58e4-b816-8920ea2f3072",
      "name": "Send to participant",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        720,
        440
      ],
      "parameters": {},
      "notes": "Connect Expo app push or WhatsApp here",
      "notesInFlow": true
    },
    {
      "id": "341fbdc7-994f-5b07-9ace-715c04ee29fc",
      "name": "Compose SLA alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        620
      ],
      "parameters": {
        "jsCode": "// SLA alert: a reminder goes to the desk, an escalation goes to the supervisor.\nconst b = $input.first().json.body;\nconst desks = { logistics: 'Logistics & Site Access', security: 'Accreditation & Security', facilities: 'Facilities & Utilities' };\nconst escalated = b.event === 'sla_escalated';\nreturn [{ json: {\n  to: escalated ? 'Participant services supervisor' : `${desks[b.desk]} desk`,\n  sub_id: b.id, ticket_id: b.ticket_id,\n  text: escalated\n    ? `Escalated: ${b.id} for ${b.pavilion} has waited ${b.waiting_minutes} min at ${desks[b.desk]} (escalation target ${b.escalate_minutes} min).`\n    : `Reminder: ${b.id} for ${b.pavilion} has waited ${b.waiting_minutes} min (target ${b.review_minutes} min). Please review.`,\n} }];"
      }
    },
    {
      "id": "dce5dcff-65a7-5289-9767-82fb4b544db6",
      "name": "Alert desk or supervisor",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        720,
        620
      ],
      "parameters": {},
      "notes": "Connect Slack, Teams or email here",
      "notesInFlow": true
    }
